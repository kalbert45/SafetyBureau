; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SafetyBureau"
run/main_scene="uid://bkrd8peg83te5"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

DialogueManager="*uid://c3rodes2l3gxb"
Bgm="*uid://0qhdfkvu0y87"
Constants="*uid://bqs3k67r5dww"
GameState="*uid://dm7ysvbd7pxfh"
Global="*uid://beedpcsa48qfg"
SignalBus="*uid://4wjqoinx4pig"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=4
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/godot_resource_groups/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "teal",
"res://Autoload/": "red",
"res://Common/": "blue",
"res://Entities/": "green",
"res://Text/": "purple"
}

[global_group]

